    {
      "cell_type": "markdown",
      "source": [
        "Let's compare the mean squared errors of the networks trained using different regularization techniques:\n"
      ],
      "metadata": {
        "id": "SDafne77hNKb"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "names = ['No_reg','L1','L2','Drop_out','Batch_norm','Data_shuffling']\n",
        "error = [no_reg, l1, l2, dp, bn, sh]\n",
        "\n",
        "plt.figure(figsize=(8, 4))\n",
        "plt.bar(names, error, width=0.6)\n",
        "plt.title(\"Mean Squared Error\", fontsize=13)\n",
        "\n",
        "for i, err in enumerate(error):\n",
        "    plt.text(i-0.2, err+0.1, str(round(err,3)), color='blue', va='center')"
      ],
