    {
      "cell_type": "code",
      "source": [
        "def generate_data(seed=43,std=0.1,samples=500):\n",
        "    np.random.seed(seed)\n",
        "    X =np.linspace(-1,1,samples)\n",
        "    f = X**3 +2*X**2 -X\n",
        "    y=f+np.random.randn(samples)*std\n",
        "\n",
        "    return X, y\n",
        "\n",
        "\n",
        "X,y = generate_data()\n",
        "f = X**3 +2*X**2 -X\n",
        "plt.plot(X, y,'rx',label=\"data samples\")\n",
        "plt.plot(X, f,label=\"true function\")\n",
        "plt.title(\"data and true function\")\n",
        "plt.legend()\n",
        "plt.show()"
